<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Разрешение заметное для пользователя, обычно благодаря постоянному уведомлению -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
     <!-- Для публикации в Google Play этот тип нужно обосновывать в Play Console -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Разрешение на отправку уведомлений -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ServiceLab">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.ServiceLab"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <!-- Определение главной точки приложения -->
                <action android:name="android.intent.action.MAIN" />
                <!-- Экран отображается как точка входа в приложение, т.е.
                 можно перейти при нажатии на иконку приложения -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--  Посторонние приложения не могут обращаться к службе -->
        <service
            android:name=".StopwatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse"> <!-- Тип службы -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="learning_stopwatch" />
        </service>
    </application>
</manifest>